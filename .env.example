# ---------------------------------------------------------------------------
# On-Prem Health-Records RAG — configuration template.
# Copy to `.env` and adjust. `.env` is git-ignored and read by docker-compose
# and (via the ONPREM_ prefix) by the server through its config loader.
# ---------------------------------------------------------------------------

# --- DocumentDB (docker-compose + server) ----------------------------------
DOCUMENTDB_PORT=10260
DOCUMENTDB_USER=docadmin
DOCUMENTDB_PASSWORD=ChangeMe_Doc123

# Full connection string the SERVER uses to reach DocumentDB.
# Note the local-dev TLS flags and retrywrites=false (DocumentDB gotcha).
ONPREM_DOCUMENTDB_URI=mongodb://docadmin:ChangeMe_Doc123@localhost:10260/?tls=true&tlsAllowInvalidCertificates=true&retrywrites=false
ONPREM_DOCUMENTDB_DB=onprem_rag

# --- Server -----------------------------------------------------------------
ONPREM_BIND_ADDRESS=0.0.0.0
ONPREM_PORT=8000

# Deployment environment. Set to `production` on real deployments: the server then
# REFUSES TO BOOT if any secret below is unset, default, or too weak. Default: development.
ONPREM_ENV=development

# JWT signing secret (HS256). MUST be at least 32 chars and changed in production.
# Generate: `openssl rand -base64 32`
ONPREM_JWT_SECRET=dev-only-change-me-to-a-long-random-string
ONPREM_JWT_TTL_HOURS=8

# Key used to encrypt stored source-DB credentials at rest.
# REQUIRED in production: must be ≥32 chars and MUST DIFFER from ONPREM_JWT_SECRET.
# Generate: `openssl rand -base64 32`
ONPREM_CREDENTIALS_KEY=

# Default admin seeded on first boot (password is hashed with argon2 before storage).
# 'password' is rejected in production (set ONPREM_ENV=production to enforce).
ONPREM_ADMIN_USERNAME=admin
ONPREM_ADMIN_PASSWORD=password

# --- Foundry Local (CHAT ONLY) ----------------------------------------------
# NOTE: Foundry Local's catalog has NO embedding models (verified on 0.8.119) —
# it is used only for chat. Embeddings come from fastembed (see below).
# Chat model: a bare alias lets the SDK pick the best registered EP at runtime.
# Prefer generic-gpu variants for chat (full context window, long multi-turn sessions).
# openvino-npu variants are 4224-ctx capped — avoid them for chat; use them only for
# small single-record roles (Extract, Verify) via the router (see Model router below).
ONPREM_CHAT_MODEL=qwen3-8b
# Model cache directory for the in-process Foundry core. The server embeds its own core
# (it does not use the `foundry` CLI service), so it does not pick up `foundry cache
# location` by itself. Leave unset to auto-follow ~/.foundry/foundry.config.json; set it
# to override. Wrong/stale value => models show as "downloaded" that aren't on disk.
# ONPREM_FOUNDRY_CACHE_DIR=D:\FoundryCache


# --- Model router (task-aware model selection + device placement) -----------
# Per-role aliases. Each must be a bare alias in the Foundry catalog or a pinned
# variant id. resolve_variant() maps the alias + device_pref to the best matching
# device variant at call time, so bare aliases are preferred (stay valid as EPs change).
ONPREM_MODEL_CHAT=qwen3-8b
ONPREM_MODEL_HEALTH_QUERY=qwen3-8b
ONPREM_MODEL_TRENDS=qwen3-8b
ONPREM_MODEL_SUMMARIZE=mistral-nemo-12b-instruct
ONPREM_MODEL_LOOKUP=qwen3-4b           # PatientLookup (fast, structured)
ONPREM_MODEL_FAST=qwen3-4b             # QueryRewrite (short output, low temp)
ONPREM_MODEL_CLASSIFY=phi-4-mini              # Intent router Tier 2 — NPU preferred, CPU fallback
ONPREM_MODEL_EXTRACTOR=phi-4-mini             # Extract — NPU preferred, CPU fallback
ONPREM_MODEL_VERIFIER=phi-4-mini-reasoning    # Verify — NPU preferred, CPU fallback

# Maximum GPU-class models resident in VRAM simultaneously.
# NPU and CPU models are exempt (separate silicon; phi-4-mini stays hot on the NPU).
ONPREM_MAX_RESIDENT_MODELS=2

# NPU placement: set false to force CPU for Extract/Verify even when an NPU is present.
ONPREM_NPU_ENABLED=true
# openvino-npu variants over this context length are skipped (prevents NPU OOM).
ONPREM_NPU_CTX_CAP=4224

# --- Intent Router v2 (plans/17) --------------------------------------------
# Allow the router to escalate ambiguous questions to the Tier-2 model classifier
# (ONPREM_MODEL_CLASSIFY). Set false to use only the Tier-0 gate + Tier-1 lexical
# markers and fall open to semantic — no model call on the routing hot path.
ONPREM_ROUTER_MODEL_ENABLED=true
# Structured counts, trends, distributions, and listings query the best-matching
# registered SQL source. Set false to force the ingested DocumentDB fallback.
ONPREM_TEXT2SQL_ENABLED=true
ONPREM_MODEL_TEXT2SQL=phi-4-mini
ONPREM_NL2SQL_TABLES_MAX=4
ONPREM_NL2SQL_FEWSHOTS=3
ONPREM_NL2SQL_MAX_ROWS=500
ONPREM_NL2SQL_TIMEOUT_SECS=30
# One shared deadline for initial SQL planning plus at most one repair.
ONPREM_NL2SQL_PLAN_TIMEOUT_SECS=30
ONPREM_NL2SQL_SAMPLE_VALUES=10
# Schema metadata maintenance. Set polling interval to 0 to disable drift checks.
ONPREM_SCHEMA_POLL_INTERVAL_SECS=300
ONPREM_SCHEMA_POLL_CONCURRENCY=2
# Bounded rows read per table for approximate distinct/null/range profiles. 0 disables profiles.
ONPREM_SCHEMA_PROFILE_SAMPLE_ROWS=256
# Capacity (entries) of the per-process LRU cache of Tier-2 route decisions.
ONPREM_ROUTER_CACHE_SIZE=512

# --- Embeddings (fastembed / ONNX Runtime, local) ---------------------------
# fastembed EmbeddingModel variant. BGE-M3: 1024-dim, multilingual, prefix-free,
# shares the reranker's ONNX stack, GPU/DirectML-capable on this host.
ONPREM_EMBEDDING_MODEL=bge-m3
ONPREM_EMBEDDING_DIMS=1024

# --- Retrieval defaults -----------------------------------------------------
ONPREM_RETRIEVAL_MODE=hybrid          # vector | hybrid
ONPREM_RRF_K=60
ONPREM_RERANK_ENABLED=true
ONPREM_RERANK_MODEL=bge-reranker-v2-m3
ONPREM_RETRIEVE_PER_SIDE=50           # candidates fetched per retriever
ONPREM_RERANK_TOP_N=30                # candidates fed to the reranker
ONPREM_CONTEXT_TOP_K=6                # passages placed in the LLM prompt
ONPREM_CONTEXT_TOTAL_TOKENS=3072       # approximate total retrieved-context budget
ONPREM_CONTEXT_PER_ROW_TOKENS=768      # approximate cap for any one source row

# Anti-hallucination gate: refuse to answer if the top passage score (post-sigmoid,
# range 0-1) falls below this floor. Default 0.30; set 0 to disable.
ONPREM_SCORE_GATE=0.30

# Multi-query expansion: paraphrase the query N ways, retrieve each, RRF together.
# Improves recall on vaguely-worded questions; cheap on a local LLM.
ONPREM_MULTI_QUERY_ENABLED=true
ONPREM_MULTI_QUERY_COUNT=3            # total query variants (original + paraphrases)

# Chunking: embed long free-text fields per passage (sliding window) rather than
# per whole record. Structured fields stay as metadata for filtering + citations.
ONPREM_CHUNK_ENABLED=true
ONPREM_CHUNK_SIZE_TOKENS=384          # ~256-512 window
ONPREM_CHUNK_OVERLAP_TOKENS=64
ONPREM_INGEST_PAGE_SIZE=256           # bounds source rows held in memory
ONPREM_INGEST_EMBED_BATCH_SIZE=32     # tune 32/64/128 for the local device

# --- Chat memory: working memory, compaction, hygiene (plan 22) -------------
# Per-turn working memory = rolling summary (if any) + a verbatim tail, bounded
# by BOTH turn count and an approximate token (word) budget.
ONPREM_HISTORY_TAIL_MAX_TURNS=8
ONPREM_HISTORY_TAIL_MAX_TOKENS=1200
ONPREM_HISTORY_MSG_CLIP=200            # word cap on an assistant message entering the tail
# Un-summarized turn count that triggers write-behind compaction (fast model,
# never on the request hot path).
ONPREM_COMPACT_AFTER_TURNS=12
# Delete conversations (and messages) older than this many days. 0 = keep forever.
ONPREM_CONVERSATION_RETENTION_DAYS=0
ONPREM_MESSAGE_MAX_BYTES=32768         # stored message content is clipped past this

# --- Optional dev source database (docker-compose --profile dev-sources) ----
DEV_PG_USER=health
DEV_PG_PASSWORD=health
DEV_PG_DB=health_records
DEV_PG_PORT=5432

# --- Performance (plan 20) --------------------------------------------------
# Pre-load fastembed embedder and reranker at boot so the first request is fast.
ONPREM_WARMUP_ENABLED=true

# Bound expensive work so overload fails quickly instead of exhausting RAM/VRAM.
ONPREM_MAX_ACTIVE_GENERATIONS=2
ONPREM_MAX_ACTIVE_RETRIEVALS=4
ONPREM_MAX_ACTIVE_INGESTIONS=1
ONPREM_MAX_INGESTIONS_PER_SOURCE=1
ONPREM_ADMISSION_TIMEOUT_MS=2000

# --- Desktop app ------------------------------------------------------------
# Base URL the Tauri bridge uses to reach the server.
VITE_DEFAULT_SERVER_URL=http://localhost:8000
