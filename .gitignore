# =============================================================================
# Monorepo .gitignore — single source of truth for the whole tree.
# Covers: onprem-rag-server (Rust), onprem-rag-app (Tauri + Vite/React),
# docker/, plans/, and repo-root files. Per-package .gitignores were folded
# in here so the monorepo has ONE ignore file.
# =============================================================================

# ── Secrets — NEVER commit ─────────────────────────────────────────────────
# Holds ONPREM_JWT_SECRET, ONPREM_ADMIN_PASSWORD, ONPREM_CREDENTIALS_KEY, and
# source-DB credentials. A leaked .env compromises the entire system.
# `.env` with no slash matches in every directory (root + onprem-rag-app/).
.env
.env.*
# ...but the committed template stays tracked.
!.env.example

# Tauri bridge persisted store — may contain the JWT at rest.
bridge-store.json

# ── Rust / Cargo (onprem-rag-server, onprem-rag-app/src-tauri) ──────────────
# `target/` (no leading slash) matches every crate's build dir in the tree.
# Cargo.lock is intentionally tracked (these are binaries/apps, not libraries).
target/
*.rs.bk

# ── Node / Vite / Tauri frontend (onprem-rag-app) ──────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# Tauri generated output.
#   - schemas/ is regenerated on every build — never tracked.
#   - gen/android/ IS tracked: it carries hand-edited customizations the build
#     depends on (AndroidManifest cleartext + network_security_config.xml for
#     LAN HTTP, package id, icons). Its own nested .gitignore files exclude the
#     regenerable parts (build/, .gradle/, local.properties, *.properties keys).
onprem-rag-app/src-tauri/gen/schemas/

# Android signing secrets — NEVER commit (belt-and-suspenders over the scaffold's
# own nested ignores). A leaked keystore lets anyone ship updates as this app.
*.jks
*.keystore
key.properties
keystore.properties
# Local Android SDK path pointer (machine-specific).
local.properties

# fastembed / ONNX model cache pulled at runtime (multi-GB).
.fastembed_cache/

# ── Logs ────────────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Editor / IDE ─────────────────────────────────────────────────────────────
# Ignore .vscode contents anywhere, but keep the shared extension recommendations.
**/.vscode/*
!**/.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Evaluation output ────────────────────────────────────────────────────────
/eval/reports/

# ── Agent tooling ────────────────────────────────────────────────────────────
# Machine-local agent skills and settings stay local.
/.agents/
.claude/settings.local.json

# ── OS cruft ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Large local-only reference material (kept on disk, never pushed) ─────────
# The Electron reference implementation + RAGAs-Eval .venv (multi-GB) and
# exported UI screenshots.
On-premise-Rag-system-for-Health-Records/
Appimages/

.agents
.playwright-mcp

plans/*
blogs/*